# Supabase (get these from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: NEVER expose to the client. Server-side / CI / migration
# scripts only. Do not prefix with NEXT_PUBLIC_. Required for the public
# trip creation route (app/api/trips/create) to write a new trip's row.
SUPABASE_SERVICE_ROLE_KEY=

# "local" | "preview" | "production" — used for the health check and to
# guard against seed/demo data being mistaken for production content.
NEXT_PUBLIC_APP_ENV=local

# Slug of the active trip this deployment serves (e.g. "kassandra-2026").
NEXT_PUBLIC_ACTIVE_TRIP_SLUG=kassandra-2026

# R9 (AI-assisted question generation, src/lib/ai/questionGenerationProvider.ts):
# server-side only -- NEVER prefix with NEXT_PUBLIC_, never sent to the
# browser, never stored in the database. Optional: with this unset (the
# default in every environment that hasn't explicitly configured it),
# generation automatically falls back to a deterministic, no-network
# "fake provider" -- local dev and every automated test run exactly this
# way, with zero setup and zero cost. Get a real key from
# https://console.anthropic.com/ once you actually want live generation.
ANTHROPIC_API_KEY=

# Force the fake provider even when ANTHROPIC_API_KEY is set (e.g. to
# keep a preview/staging deployment cost-free while still testing the
# full admin review flow with a real-looking key configured). Any value
# other than exactly "fake" is ignored -- omit this var entirely to use
# the real provider whenever a key is present.
AI_PROVIDER=
