{
  "name": "roam",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:sql": "psql -v ON_ERROR_STOP=1 -f supabase/tests/battle_scoring.test.sql",
    "test:sql:fractional": "psql -v ON_ERROR_STOP=1 -f supabase/tests/battle_scoring_fractional_average.test.sql",
    "test:sql:completion": "psql -v ON_ERROR_STOP=1 -f supabase/tests/profile_completion_signal.test.sql",
    "test:sql:record-battle-answer": "psql -v ON_ERROR_STOP=1 -f supabase/tests/record_battle_answer_atomicity.test.sql",
    "test:sql:r1": "psql -v ON_ERROR_STOP=1 -f supabase/tests/r1_auth_ownership_rls.test.sql",
    "test:sql:r1-first-insert": "psql -v ON_ERROR_STOP=1 -f supabase/tests/r1_participant_first_insert_returning.test.sql",
    "test:sql:content-isolation": "psql -v ON_ERROR_STOP=1 -f supabase/tests/content_trip_isolation.test.sql",
    "test:sql:record-answer": "psql -v ON_ERROR_STOP=1 -f supabase/tests/record_answer.test.sql",
    "test:sql:record-answer-rollback": "psql -v ON_ERROR_STOP=1 -f supabase/tests/record_answer_atomicity_fault_injection.test.sql",
    "test:sql:integrated-flow": "psql -v ON_ERROR_STOP=1 -f supabase/tests/integrated_join_discover_battle_flow.test.sql",
    "test:sql:batch2-activity": "psql -v ON_ERROR_STOP=1 -f supabase/tests/batch2_trip_activity_rls.test.sql",
    "test:sql:batch2-lockdown": "psql -v ON_ERROR_STOP=1 -f supabase/tests/batch2_participant_lockdown.test.sql",
    "test:sql:batch2-battle-authz": "psql -v ON_ERROR_STOP=1 -f supabase/tests/batch2_battle_aggregate_authz.test.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.446.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vitest": "^1.6.1"
  }
}
